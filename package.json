{
  "name": "mira_device",
  "version": "2.0.0",
  "description": "DSH「输入」插件：摄像头 / 麦克风 / 虚拟采集器（muse_galaxy 等）统一成一路输入，自动按 VAD 分段语音、按间隔自动推帧，并把识别结果插话进会话；提供 miraDevice 服务与 input_* 工具，设置页「输入」，依赖 mira_media",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "camera",
    "microphone",
    "capture",
    "vad",
    "vision"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stella-Mira/mira_device.git"
  }
}
